<project name="AkeebaReleaseSystem" description="Akeeba Release System" default="git" >
	<import file="${phing.dir}/../buildfiles/phing/common.xml" />
	<property environment="build.env" />
	<property name="node.bin.dir" value="${user.home}/.nvm/versions/node/v24.19.0/bin" />

	<fileset dir="${dirs.component}" id="component">
		<include name="api/**"/>
		<include name="backend/**"/>
		<include name="frontend/**"/>
		<include name="language/**"/>
		<include name="media/**"/>

		<include name="*"/>

		<exclude name="backend/views/**"/>
		<exclude name="frontend/views/**"/>

		<exclude name="cli/**"/>
		<exclude name="LICENSE.txt"/>
		<exclude name="script.ars.php"/>
	</fileset>

	<fileset dir="${dirs.release}" id="package">
		<include name="com_*.zip" />
		<include name="mod_*.zip" />
		<include name="plg_*.zip" />
		<include name="lib_*.zip" />
		<include name="file_fef*.zip" />
		<include name="pkg_*.xml" />
		<include name="language/**"/>
		<include name="*.txt" />
		<include name="script.ars.php" />
	</fileset>

	<target name="git" description="Makes only packages, not the documentation"
			depends="new-release,setup-properties,compile-javascript,compile-css,component-packages">
	</target>

	<target name="compile-javascript" description="Minify JavaScript files">
		<exec executable="/usr/bin/env"
		      dir="${dirs.root}/../buildfiles" checkreturn="true" passthru="true">
			<!-- Terser's launcher resolves node through /usr/bin/env. -->
			<arg value="PATH=${node.bin.dir}:${build.env.PATH}" />
			<arg value="${node.bin.dir}/node" />
			<arg value="build-js.mjs" />
			<arg value="${dirs.component}/media/js" />
		</exec>
	</target>

	<target name="compile-css" description="Compile SCSS to minified CSS">
		<exec executable="/usr/bin/env" dir="${dirs.component}/media/css" checkreturn="true" passthru="true">
			<!-- The npm Sass launcher also resolves node through /usr/bin/env. -->
			<arg value="PATH=${node.bin.dir}:${build.env.PATH}" />
			<arg value="${node.bin.dir}/sass" />
			<arg value="${dirs.component}/media/css:${dirs.component}/media/css" />
			<arg value="-s" />
			<arg value="compressed" />
		</exec>
	</target>
</project>
